; Engine configuration file. Edit using Godot's Project Settings when possible.
config_version=5

[application]

config/name="PSXRetroClassic"
run/main_scene="res://scenes/startup.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Independent retro sandbox shooter project. Minimal FPS foundation."

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.11, 1)

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

quit_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

capture_mouse={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
